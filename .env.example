# Copy this file to .env and fill in local values. Never put an API key here.
# The Vast CLI reads its scoped key from ~/.config/vastai/vast_api_key.

VAST_MACHINE_ID=
VAST_OWN_OFFER_ID=
VAST_OWN_IMAGE=pytorch/pytorch:latest
VAST_OWN_DISK_GB=20
VAST_OWN_LABEL_PREFIX=owned-reclaim

# The port values document the reviewed host configuration. Scripts do not
# change firewall rules.
VAST_DIRECT_PORT_START=
VAST_DIRECT_PORT_END=
VAST_GPU_COUNT=

# Private runtime state. Keep this outside the repository.
# VAST_STATE_DIR=/home/operator/.local/state/vast-host-golden-path

# Optional local monitoring thresholds. Set these from the owned hardware's
# validated operating envelope; there is no universal Vast value.
VAST_GPU_TEMP_WARN_C=
VAST_DOCKER_DISK_WARN_PERCENT=

